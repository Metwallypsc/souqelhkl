generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  HIDDEN
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  AWAITING_VENDOR_CONFIRMATION
  READY_FOR_SHIPPING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum VendorOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  DELIVERED_TO_COLLECTION_CENTER
}

model User {
  id           String          @id @default(cuid())
  username     String?         @unique
  name         String
  email        String?         @unique
  phone        String          @unique
  passwordHash String
  role         UserRole        @default(CUSTOMER)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customer     CustomerProfile?
  vendorUser   VendorUser?
  orders       Order[]
  auditLogs    AuditLog[]      @relation("AuditActor")
  vendorApplications VendorApplication[]
}

model VendorApplication {
  id                String                  @id @default(cuid())
  userId            String?
  companyName       String
  taxNumber         String
  firstName         String
  lastName          String
  email             String
  phone             String
  description       String?
  address           String
  city              String
  country           String
  governorate       String
  taxCardImageDataUrl String?
  username          String
  passwordHash      String
  status            VendorApplicationStatus @default(PENDING)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  user              User?                   @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@index([phone])
}

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  governorate    String
  city           String
  addressLine    String
  googleMapsLink String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Vendor {
  id          String        @id @default(cuid())
  name        String
  storeName   String?
  logoUrl     String?
  slug        String        @unique
  phone       String
  address     String?
  governorate String?
  city        String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       VendorUser[]
  listings    Listing[]
  vendorOrders VendorOrder[]
}

model VendorUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  vendorId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  nameAr    String
  nameEn    String?
  slug      String     @unique
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String
  nameAr      String
  nameEn      String?
  slug        String        @unique
  description String?
  status      ProductStatus @default(PENDING_REVIEW)
  isHidden    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    Category      @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  options     ProductOption[]
  listings    Listing[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altAr     String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  nameAr    String
  nameEn    String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ListingOption[]
}

model Listing {
  id                 String             @id @default(cuid())
  productId          String
  vendorId           String
  sku                String?
  unitNameAr         String
  unitNameEn         String?
  priceEgp           Decimal            @db.Decimal(12, 2)
  stockQuantity      Decimal            @db.Decimal(12, 3)
  weightGrams        Int                @default(0)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  product            Product            @relation(fields: [productId], references: [id])
  vendor             Vendor             @relation(fields: [vendorId], references: [id])
  options            ListingOption[]
  orderItems         OrderItem[]

  @@index([productId])
  @@index([vendorId])
  @@index([availabilityStatus])
}

model ListingOption {
  id              String        @id @default(cuid())
  listingId       String
  productOptionId String
  valueAr         String
  valueEn         String?
  priceDeltaEgp   Decimal       @default(0) @db.Decimal(12, 2)
  stockQuantity   Decimal?      @db.Decimal(12, 3)
  weightDeltaGrams Int          @default(0)
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])
}

model Order {
  id                  String         @id @default(cuid())
  customerId          String
  status              OrderStatus    @default(NEW)
  paymentMethod       PaymentMethod
  subtotalEgp         Decimal        @db.Decimal(12, 2)
  shippingFeeEgp      Decimal        @db.Decimal(12, 2)
  totalEgp            Decimal        @db.Decimal(12, 2)
  totalWeightGrams    Int            @default(0)
  cancellationReason  String?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  customer            User           @relation(fields: [customerId], references: [id])
  items               OrderItem[]
  vendorOrders        VendorOrder[]
  payment             Payment?
  shippingDetail      ShippingDetail?
  statusHistory       OrderStatusHistory[]
  commissions         Commission[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  listingId         String
  vendorId          String
  productNameAr     String
  vendorName        String
  unitNameAr        String
  quantity          Decimal  @db.Decimal(12, 3)
  unitPriceEgp      Decimal  @db.Decimal(12, 2)
  lineTotalEgp      Decimal  @db.Decimal(12, 2)
  weightGrams       Int      @default(0)
  selectedOptions   Json?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing           Listing  @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([vendorId])
}

model VendorOrder {
  id              String            @id @default(cuid())
  orderId         String
  vendorId        String
  status          VendorOrderStatus @default(PENDING)
  rejectionReason String?
  subtotalEgp     Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor            @relation(fields: [vendorId], references: [id])

  @@unique([orderId, vendorId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transferImageUrl String?
  reviewedById   String?
  reviewNotes    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingDetail {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  governorate        String
  city               String
  addressLine        String
  phone              String
  googleMapsLink     String?
  notes              String?
  collectionCenterId String?
  manualExtraFeeEgp  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Commission {
  id         String   @id @default(cuid())
  orderId    String
  vendorId   String
  rate       Decimal  @default(0.01) @db.Decimal(5, 4)
  amountEgp  Decimal  @db.Decimal(12, 2)
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
}
